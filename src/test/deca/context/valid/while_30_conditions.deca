// Descritpion:
//      while contenant 30 conditions pour vérifier que le compilateur arrive bien à toutes les gérer en meme temps
//      Incrémentation d'une variable à chaque itération
//      Vérification à la fin du programme qu'on a bien effectué le bon nombre d'itérations
//

int i = 0;

while (i != 20 && i != 21 && i != 22 && i != 23 && i != 24 && i != 25 && i != 26 && i != 27 && i != 28 && i != 29 &&
           i != 30 && i != 31 && i != 32 && i != 33 && i != 34 && i != 35 && i != 36 && i != 37 && i != 38 && i != 39 && i != 40 &&
           i != 41 && i != 42 && i != 43 && i != 44 && i != 45 && i != 46 && i != 47 && i != 48 && i != 49) {
    i++;
}
assert(i==19);
