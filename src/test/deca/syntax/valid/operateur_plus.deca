{
    int a = 5;
    int b = 3;
    int c = 2;
    int d = 4;
    int e = 7;
    int f = 1;
    int g = 8;
    int h = 6;
    int i = 9;
    int j = 10;
    int k = 15;
    int result = a + b - c * d / 2 + e - f * 3 + g / 4 + h - 2 + i * 3 - f + j / 2 - c * 2 + k;
    println(result);
}