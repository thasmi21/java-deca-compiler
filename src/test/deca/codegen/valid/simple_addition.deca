{
    int i = 2;
    int j = 4;
    int k = 7;
    println("La valeur de i est: ", i);
    println("Voici la valeur de j: ", j);
    //println(i);
    println("La somme de ", i, " et ", j, " vaut :", i+j);

    println("", i, " + ", j, " * ", k, " = ", i+j*k);
