// Description :
//   tests de la redéfinition de méthodes
//

class Animal {
    void speak() {
        println("This is an animal.");
    }
}

class Dog extends Animal {
    void speak() {
        println("Woof!");
    }
}

class Cat extends Animal {
    void speak() {
        println("Meow!");
    }
}

Animal a = new Animal();
a.speak();

Animal d = new Dog();
d.speak();

Animal c = new Cat();
c.speak();
