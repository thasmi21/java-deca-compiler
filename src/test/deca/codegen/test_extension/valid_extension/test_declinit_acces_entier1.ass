; start main program
	TSTO #2
	BOV pile_pleine
	ADDSP #2
; Main program
; Debut declaration des variables
	NEW #2, R2
	LOAD #1, R3
	STORE R3, 0(R2)
	LOAD #2, R3
	STORE R3, 1(R2)
	STORE R2, 2(GB)
; Beginning of main instructions:
	LOAD #8, R2
	LOAD 2(GB), R3
	LEA 0(R3), R3
	STORE R2, 0(R3)
	WSTR "x[0] vaut: "
	LOAD 2(GB), R2
	LEA 0(R2), R2
	LOAD 0(R2), R2
	LOAD R2, R1
	WINT
	WNL
	HALT
pile_pleine:
	WSTR "Erreur: La pile est pleine"
	WNL
	ERROR
; end main program
