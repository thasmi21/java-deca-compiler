; start main program
	TSTO #1
	BOV pile_pleine
	ADDSP #1
; Main program
; Debut declaration des variables
	NEW #2, R2
	LOAD #1, R3
	STORE R3, 0(R2)
	LOAD #2, R3
	STORE R3, 1(R2)
	STORE R2, 1(GB)
; Beginning of main instructions:
	LOAD #8, R2
	LOAD 1(GB), R3
	LOAD #0, R8
	LOAD #1, R7
	MUL R8, R7
	LOAD #0, R6
	ADD R7, R6
	LOAD #0, R4
	ADD R6, R4
	LOAD #0, R5
	SUB R5, R4
	LEA 0(R3, R4), R3
	STORE R2, 0(R3)
	WSTR "x[0] vaut: "
	LOAD 1(GB), R2
	LEA 0(R2), R2
	LOAD 0(R2), R2
	LOAD R2, R1
	WINT
	WNL
	HALT
pile_pleine:
	WSTR "Erreur: La pile est pleine"
	WNL
	ERROR
; end main program
