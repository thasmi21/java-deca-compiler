class Array {
    int[] tab;

    void setTab(int[] tab){
        this.tab = tab;
    }

    int[] getTab() {
        return this.tab;
    }

    int sum(int[] tab, int len) {
        int i=0;
        int total = 0;
        while (i < len) {
            total = total + tab[i];
            i = i + 1;
        }
        return total;
    }
}


// Script pour utiliser la bibliothèque
{
    Array array = new Array();
    int[] tab;
    int len;
    int [] x = {9,1,6,5,7,8,9,7}; //Exemple
    len = x.length; 
    array.setTab(x);
    tab = array.getTab();
    
    println(array.sum(tab, len)); // J'aurai pu enlever len des parametres mais le codegen ne le gère pas
}